{
  "name": "deuclient",
  "productName": "DeuClient",
  "version": "1.0.0",
  "description": "DeuClient - Minecraft launcher with its own Fabric client",
  "author": "EmilDeuOfficial",
  "license": "UNLICENSED",
  "main": "dist-electron/electron/main.js",
  "type": "commonjs",
  "scripts": {
    "icons": "node tools/generate-icons.cjs && node tools/generate-mod-assets.cjs && node tools/generate-cosmetics.cjs && node tools/generate-ingame-ui.cjs",
    "embed-mod": "node tools/embed-mod.cjs",
    "build:main": "tsc -p electron/tsconfig.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "start": "npm run build:main && npm run build:renderer && electron .",
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "npm run icons && npm run embed-mod && npm run build:main && npm run build:renderer && electron-builder --win nsis --publish never",
    "release": "node tools/release.cjs"
  },
  "build": {
    "appId": "eu.deuclient.app",
    "publish": [
      {
        "provider": "github",
        "owner": "EmilDeuOfficial",
        "repo": "DeuClient"
      }
    ],
    "productName": "DeuClient",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/mods",
        "to": "mods"
      },
      {
        "from": "resources/default-profile",
        "to": "default-profile"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "DeuClient-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "DeuClient",
      "menuCategory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1031",
      "uninstallDisplayName": "DeuClient"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
}
