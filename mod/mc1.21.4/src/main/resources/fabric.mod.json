{
  "schemaVersion": 1,
  "id": "deucore",
  "version": "${version}",
  "name": "DeuCore",
  "description": "DeuClient look for Minecraft: custom loading screen, main menu, pause and multiplayer visuals. Visual only - no cheats.",
  "authors": ["EmilDeuOfficial"],
  "license": "All-Rights-Reserved",
  "icon": "assets/deucore/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["eu.deusmp.deucore.DeuCore"]
  },
  "mixins": ["deucore.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}
