{
  "schemaVersion": 1,
  "id": "deucore",
  "version": "${version}",
  "name": "DeuCore",
  "description": "DeuClient for Minecraft: custom main menu, loading screen, mod menu (Right Shift), capes, wings, zoom and crosshair. Visual only - no cheats.",
  "authors": ["EmilDeuOfficial"],
  "license": "All-Rights-Reserved",
  "icon": "assets/deucore/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "eu.deusmp.deucore.DeuCore",
      "de.erik.glasshud.GlassHudClient",
      "de.erik.discordglass.DiscordGlassClient",
      "de.erik.glassscout.GlassScoutClient"
    ]
  },
  "mixins": ["deucore.mixins.json"],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
